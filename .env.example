# Deaf Creator Platform Environment Variables
# Copy this file to .env.local and fill in the values

# ===========================================
# Application Configuration
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ===========================================
# Backend API (Flask)
# ===========================================
FLASK_API_URL=http://localhost:5000
API_SECRET_KEY=your-api-secret-key-here

# ===========================================
# Video Processing 
# ===========================================


# ===========================================
# Payment Processing
# ===========================================
# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox  # sandbox or live

# ===========================================
# Database
# ===========================================
DATABASE_URL=postgresql://deaf_creator:your-secure-postgres-password-here@localhost:5432/deaf_creator_db
POSTGRES_USER=deaf_creator
POSTGRES_PASSWORD=your-secure-postgres-password-here
POSTGRES_DB=deaf_creator_db

# ===========================================
# Redis (for caching and job queues)
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# Email Service (optional)
# ===========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@deafcreators.mbtquniverse.com

# ===========================================
# Analytics (optional)
# ===========================================
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
MIXPANEL_TOKEN=your-mixpanel-token
